# Copia este archivo como .env y rellena los valores.
# .env nunca se sube al repositorio.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_URL_CONTACTO=          # calendario o WhatsApp del CTA final
VITE_URL_PRIVACIDAD=
VITE_URL_WEB=                # web de STRATTONWORLD. No esta en §11: la pide el
                             # enlace secundario del caso de cero zonas (§8.9).
                             # Si se deja vacia, ese enlace no se renderiza.

# Las claves de abajo NO van aqui ni en el frontend.
# Se configuran solo en las variables de entorno de la Edge Function de Supabase:
#   SUPABASE_SERVICE_ROLE_KEY
#   RESEND_API_KEY
